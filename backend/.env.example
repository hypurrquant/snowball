# ─── RPC ───
RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CHAIN_ID=102031

# ─── Operator Wallet (for oracle push + settlement) ───
OPERATOR_PRIVATE_KEY=0x_your_operator_private_key_here

# ─── Contract Addresses ───
ORACLE_BTC_ADDRESS=0x_btc_mock_oracle_address
ORACLE_ADDRESS=0x_snowball_oracle_address
WCTC_ADDRESS=0x_wctc_token_address
LSTCTC_ADDRESS=0x_lstctc_token_address
SBUSD_ADDRESS=0x_sbusd_token_address
CTC_PRICE_OVERRIDE=0.0
LSTCTC_PREMIUM=1.05
CLEARING_HOUSE_ADDRESS=0x_clearing_house_proxy_address
OPTIONS_VAULT_ADDRESS=0x_options_vault_proxy_address
SNOWBALL_OPTIONS_ADDRESS=0x_snowball_options_proxy_address
OPTIONS_RELAYER_ADDRESS=0x_options_relayer_proxy_address

# ─── Server ───
HOST=0.0.0.0
PORT=8000

# ─── Oracle Config ───
ORACLE_PUSH_INTERVAL=10
PRICE_SOURCE=binance

# ─── Options Config ───
ROUND_DURATION=300
SETTLEMENT_POLL_INTERVAL=5
BATCH_SIZE=50
